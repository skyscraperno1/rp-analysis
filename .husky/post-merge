#!/bin/sh
. "$(dirname "$0")/common.sh"

[ -n "$CI" ] && exit 0

PATH="/usr/local/bin:$PATH"

# pull / merge 后如果依赖清单有变化，自动同步依赖，避免本地与 CI --frozen-lockfile 不一致
changed="$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD 2>/dev/null || true)"

case "$changed" in
  *pnpm-lock.yaml* | *package.json*)
    echo "post-merge: 依赖清单有变更（pnpm-lock.yaml / package.json），重新安装..."
    pnpm install || exit 1
    ;;
esac
