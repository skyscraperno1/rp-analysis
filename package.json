{
  "name": "roller-stud-annotator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint:eslint": "eslint --cache --max-warnings 0 \"{src,scripts}/**/*.{js,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write \"{src,scripts}/**/*.{js,ts,tsx,css,json,html}\"",
    "lint": "pnpm lint:eslint && pnpm lint:prettier",
    "check:sort": "tsx scripts/check-sorting.ts",
    "check:tracks": "tsx scripts/check-tracks.ts",
    "check:tracksort": "tsx scripts/check-tracksort.ts",
    "check:roundtrip": "tsx scripts/check-roundtrip.ts",
    "check:all": "pnpm check:sort && pnpm check:tracks && pnpm check:tracksort && pnpm check:roundtrip",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "9.x"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "konva": "^10.9.1",
    "lucide-react": "^1.74.0",
    "overlayscrollbars": "^2.17.1",
    "overlayscrollbars-react": "^0.5.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "react-tooltip": "^6.0.13",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/types": "^20.0.0",
    "@eslint/js": "^9.38.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.3.8"
  }
}
